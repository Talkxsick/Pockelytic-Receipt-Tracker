# For local dev, leave this unset -- Vite's dev server proxies /api to
# localhost:8000 automatically (see vite.config.js).
#
# For production on Vercel, set this as an Environment Variable in your
# Vercel project settings (not in this file, which isn't deployed) to
# your deployed backend's URL, e.g.:
# VITE_API_BASE_URL=https://your-backend.up.railway.app/api
